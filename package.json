{
  "name": "fxinstagram",
  "private": true,
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "check": "ultracite check",
    "fix": "ultracite fix",
    "knip": "knip",
    "prepare": "lefthook install",
    "start": "bun index.ts",
    "typecheck": "tsrs --noEmit",
    "test": "bun test",
    "test:unit": "bun test --path-ignore-patterns \"*/e2e/*\"",
    "test:e2e": "bun test ./__tests__/e2e",
    "dev": "bun alchemy dev alchemy.run.ts",
    "alchemy:check": "bun test __tests__/alchemy-stack.test.ts",
    "alchemy:deploy": "bun alchemy deploy alchemy.run.ts --stage dev_fxinstagram --yes",
    "alchemy:deploy:prod": "bun alchemy deploy alchemy.run.ts --stage prod",
    "alchemy:destroy": "bun alchemy destroy alchemy.run.ts --stage dev_fxinstagram"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.85",
    "@effect/platform-bun": "4.1.2",
    "@effect/platform-node": "4.1.2",
    "@types/bun": "^1.4.4",
    "alchemy": "2.0.0-beta.85",
    "effect": "4.1.2",
    "eslint-plugin-github": "6.1.2",
    "eslint-plugin-jsdoc": "^65.4.2",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-tsdoc": "^0.5.4",
    "knip": "6.44.0",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "tsrs": "0.20.1-ts7.1.0-beta",
    "ultracite": "8.1.0"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.1.2"
  },
  "packageManager": "bun@1.4.4"
}
