{
  "name": "fxinstagram",
  "private": true,
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "lefthook install",
    "start": "bun index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "dev": "bun alchemy dev alchemy.run.ts",
    "alchemy:check": "bun test __tests__/alchemy-stack.test.ts",
    "alchemy:deploy": "bun alchemy deploy alchemy.run.ts --stage dev_fxinstagram",
    "alchemy:deploy:prod": "bun alchemy deploy alchemy.run.ts --stage prod",
    "alchemy:destroy": "bun alchemy destroy alchemy.run.ts --stage dev_fxinstagram"
  },
  "devDependencies": {
    "@effect/platform-bun": "4.0.0-rc.111",
    "@effect/platform-node": "4.0.0-rc.111",
    "@types/bun": "latest",
    "@typescript/native": "npm:typescript@^7.0.2",
    "alchemy": "2.0.0-beta.74",
    "effect": "4.0.0-rc.111",
    "eslint-plugin-github": "6.1.2",
    "eslint-plugin-sonarjs": "^4.2.0",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "ultracite": "7.10.6"
  },
  "packageManager": "bun@1.4.0"
}
