{
  "name": "fxinstagram",
  "private": true,
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "lefthook install",
    "start": "bun index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:unit": "bun test --path-ignore-patterns \"*/e2e/*\"",
    "test:e2e": "bun test ./__tests__/e2e",
    "dev": "bun alchemy dev alchemy.run.ts",
    "alchemy:check": "bun test __tests__/alchemy-stack.test.ts",
    "alchemy:deploy": "bun alchemy deploy alchemy.run.ts --stage dev_fxinstagram --yes",
    "alchemy:deploy:prod": "bun alchemy deploy alchemy.run.ts --stage prod",
    "alchemy:destroy": "bun alchemy destroy alchemy.run.ts --stage dev_fxinstagram"
  },
  "devDependencies": {
    "@effect/platform-bun": "4.0.0-rc.115",
    "@effect/platform-node": "4.0.0-rc.115",
    "@types/bun": "^1.4.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "alchemy": "2.0.0-beta.79",
    "effect": "4.0.0-rc.115",
    "eslint-plugin-github": "6.1.2",
    "eslint-plugin-sonarjs": "^4.2.1",
    "lefthook": "^2.1.14",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "ultracite": "7.12.0"
  },
  "packageManager": "bun@1.4.2"
}
